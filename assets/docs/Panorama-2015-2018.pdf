	/* FASE EXTERNA — seis etapas */
.etapa-fase .elementor-icon-box-wrapper {
    text-align: center !important;
}

.etapa-fase .elementor-icon-box-icon {
    position: relative !important;
    display: inline-block !important;
}

/* Círculo com a numeração */
.etapa-fase .elementor-icon-box-icon::before {
    position: absolute;
    top: -16px;
    left: 50%;
    z-index: 5;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    transform: translateX(-50%);
    color: #ffffff;
    font: 700 13px/30px Arial, sans-serif;
    text-align: center;
}

/* Setas entre as etapas */
.etapa-fase:not(.etapa-06) .elementor-icon-box-icon::after {
    content: "→";
    position: absolute;
    top: 50%;
    right: -58px;
    color: #8ccfd7;
    font: 700 34px/1 Arial, sans-serif;
    transform: translateY(-50%);
}

/* Números */
.etapa-01 .elementor-icon-box-icon::before { content: "01"; }
.etapa-02 .elementor-icon-box-icon::before { content: "02"; }
.etapa-03 .elementor-icon-box-icon::before { content: "03"; }
.etapa-04 .elementor-icon-box-icon::before { content: "04"; }
.etapa-05 .elementor-icon-box-icon::before { content: "05"; }
.etapa-06 .elementor-icon-box-icon::before { content: "06"; }

/* Cores de cada etapa */
.etapa-01 .elementor-icon,
.etapa-01 .elementor-icon-box-icon::before {
    color: #168fc0 !important;
    background-color: #168fc0;
}

.etapa-02 .elementor-icon,
.etapa-02 .elementor-icon-box-icon::before {
    color: #24b6b0 !important;
    background-color: #24b6b0;
}

.etapa-03 .elementor-icon,
.etapa-03 .elementor-icon-box-icon::before {
    color: #2f80c0 !important;
    background-color: #2f80c0;
}

.etapa-04 .elementor-icon,
.etapa-04 .elementor-icon-box-icon::before {
    color: #8eba42 !important;
    background-color: #8eba42;
}

.etapa-05 .elementor-icon,
.etapa-05 .elementor-icon-box-icon::before {
    color: #27aaa8 !important;
    background-color: #27aaa8;
}

.etapa-06 .elementor-icon,
.etapa-06 .elementor-icon-box-icon::before {
    color: #173e86 !important;
    background-color: #173e86;
}

/* Impede palavras cortadas com hífen */
.etapa-fase .elementor-icon-box-title,
.etapa-fase .elementor-icon-box-title a {
    hyphens: none !important;
    word-break: normal !important;
}

/* No celular, esconde as setas */
@media (max-width: 767px) {
    .etapa-fase .elementor-icon-box-icon::after {
        display: none !important;
    }
}
	/* FASE EXTERNA — correção dos números */
.etapa-fase .elementor-icon-box-icon::before {
    color: #ffffff !important;
}

/* Remove as setas anteriores */
.etapa-fase .elementor-icon-box-icon::after {
    display: none !important;
}

/* Posiciona as setas entre as caixas */
.etapa-fase {
    position: relative !important;
    overflow: visible !important;
}

.etapa-fase:not(.etapa-06)::after {
    content: "→";
    position: absolute;
    top: 62px;
    right: -17px;
    z-index: 10;
    color: #8ccfd7;
    font: 700 25px/1 Arial, sans-serif;
}

/* Ajusta os títulos */
.etapa-fase .elementor-icon-box-title,
.etapa-fase .elementor-icon-box-title a {
    font-size: 13px !important;
    line-height: 1.25 !important;
    hyphens: none !important;
    word-break: keep-all !important;
    overflow-wrap: normal !important;
}

/* Esconde as setas no celular */
@media (max-width: 767px) {
    .etapa-fase::after {
        display: none !important;
    }
}
/* FASE EXTERNA — seis contêineres com a mesma largura */
@media (min-width: 1025px) {

    .linha-etapas-fase {
        display: flex !important;
        width: 100% !important;
    }

    .linha-etapas-fase > .e-con-inner {
        display: grid !important;
        grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
        align-items: start !important;
        column-gap: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 auto !important;
    }

    .linha-etapas-fase > .e-con-inner > .e-con {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 5px !important;
    }
}
	/* FASE EXTERNA — largura semelhante ao modelo */
.texto-fase-externa,
.texto-fase-externa > .e-con-inner,
.linha-etapas-fase,
.linha-etapas-fase > .e-con-inner {
    width: 100% !important;
    max-width: 760px !important;
    margin-left: auto !important;
    margin-right: auto !important;
}

/* Texto mais compacto */
.texto-fase-externa .elementor-widget-text-editor {
    width: 100% !important;
    max-width: 720px !important;
    margin: 0 auto !important;
}

.texto-fase-externa,
.texto-fase-externa p {
    font-size: 16px !important;
    line-height: 1.4 !important;
    text-align: justify !important;
}

/* Reduz os círculos e os ícones */
.linha-etapas-fase .etapa-fase .elementor-icon {
    display: inline-flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: 74px !important;
    height: 74px !important;
    padding: 15px !important;
    font-size: 34px !important;
}

/* Reduz os números */
.linha-etapas-fase .etapa-fase .elementor-icon-box-icon::before {
    top: -12px !important;
    width: 24px !important;
    height: 24px !important;
    font-size: 11px !important;
    line-height: 24px !important;
}

/* Títulos menores */
.linha-etapas-fase .etapa-fase .elementor-icon-box-title,
.linha-etapas-fase .etapa-fase .elementor-icon-box-title a {
    font-size: 10px !important;
    line-height: 1.15 !important;
}

/* Reposiciona as setas para os ícones menores */
.linha-etapas-fase .etapa-fase:not(.etapa-06)::after {
    top: 43px !important;
    right: -12px !important;
    font-size: 20px !important;
}
</style>
